<?xml version="1.0" encoding="UTF-8"?>
<!--
  CryptoLens build file.
  Produces a single runnable JAR (target/cryptolens.jar) that contains
  the app plus all dependencies, so the runtime Docker stage only needs a JRE.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cryptolens</groupId>
  <artifactId>cryptolens</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <!-- Java 17 is the LTS baseline used by the Docker base image. -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Javalin is a small web framework: routing + static files + JSON helpers. -->
    <javalin.version>6.3.0</javalin.version>
  </properties>

  <dependencies>
    <!-- Web layer: HTTP server, routing, static file serving. -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>${javalin.version}</version>
    </dependency>

    <!-- JSON parsing/serialization for CoinGecko, Frankfurter, and our API responses. -->
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20240303</version>
    </dependency>

    <!-- Javalin logs through SLF4J; this is the simplest binding that prints to stdout. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>
  </dependencies>

  <build>
    <!-- Predictable artifact name for the Dockerfile to copy. -->
    <finalName>cryptolens</finalName>

    <plugins>
      <!--
        Shade plugin bundles every dependency into target/cryptolens.jar
        and sets the Main-Class manifest, so `java -jar` works with no classpath.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- Keep the original pom.xml readable; don't emit a stripped copy. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.cryptolens.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>